# Configuración de MongoDB Atlas para la Práctica NoSQL
# Copia este archivo a ".env" y reemplaza con tus credenciales reales:
# cp .env.example .env

# Cadena de conexión obtenida en Atlas (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<tu-cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos y colección (puedes dejarlos por defecto o personalizarlos)
MONGODB_DATABASE=practica_dask
MONGODB_COLLECTION=agregados

# Identificador acordado por el equipo (ejemplo: equipo-1, equipo-alvarenga, etc.)
RUN_ID=equipo-2
